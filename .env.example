# Names only. Real values live in Vercel project settings, never in git.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Sandbox is the DEFAULT. lib/payfast.js only uses live PayFast when this is exactly "false".
# Unset or any other value = sandbox. Set to "false" in production only, after setting the three PAYFAST_* values above.
PAYFAST_SANDBOX=
