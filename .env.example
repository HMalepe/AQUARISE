# Names only. Real values live in Vercel project settings, never in git.

# PayFast. Sandbox is the DEFAULT. lib/payfast.js only uses live PayFast when PAYFAST_SANDBOX is exactly "false".
# Unset or any other value = sandbox. In live mode all three credentials are REQUIRED (including the passphrase,
# which must match the one set in the PayFast dashboard) or checkout and the ITN handler return 503.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=

# Supabase order storage (server-side only, never in client code). Use the project's SECRET / service-role key.
# Required in live mode; optional in sandbox (without it, sandbox checkout works but orders are not recorded).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used for PayFast return/cancel/notify URLs. Must be https. Defaults to https://aquarise.co.za.
# Set it on Vercel preview environments if you test payments there.
SITE_URL=
